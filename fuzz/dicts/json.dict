# libFuzzer dictionary for the JSON-decoding targets
# (store_decode, backup_decode, raft_rpc_decode, dto_decode).
# Pass with: cargo +nightly fuzz run --features api <target> -- -dict=fuzz/dicts/json.dict

# --- JSON punctuation and literals -----------------------------------------
"{"
"}"
"["
"]"
":"
","
"\""
"null"
"true"
"false"
"0"
"-1"
"1e999"
"9223372036854775807"
"-9223372036854775808"
"18446744073709551615"
"2147483647"
"-2147483648"
"\\u0000"
"\\ud800"


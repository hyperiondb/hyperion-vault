# Node-to-node port hardening. All three are off by default so an upgrade
# changes nothing. Roll VAULT_CLUSTER_TOKEN out to every node first, then set
# VAULT_CLUSTER_AUTH_REQUIRED=true on every node; the other order refuses
# requests from nodes that have not been rolled yet.
# VAULT_RAFT_BIND=0.0.0.0
# VAULT_CLUSTER_TOKEN=
# VAULT_CLUSTER_AUTH_REQUIRED=false
# VAULT_RAFT_PEER_CHECK=false
